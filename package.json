{
  "name": "x-realtime-monitor",
  "version": "1.0.0",
  "description": "Free local X account monitoring through a dedicated browser profile",
  "type": "module",
  "bin": {
    "x-monitor": "bin/x-monitor.js"
  },
  "scripts": {
    "start": "node bin/x-monitor.js run --config config.json",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffliu05042/x-realtime-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/jeffliu05042/x-realtime-monitor/issues"
  },
  "homepage": "https://github.com/jeffliu05042/x-realtime-monitor#readme",
  "dependencies": {
    "puppeteer-core": "^25.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "linkedom": "^0.18.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
